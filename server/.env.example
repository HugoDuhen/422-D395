# Local (Postgres installé en local) :
# DATABASE_URL="postgresql://section_app:section_app_pw@localhost:5432/section_db"
# Prod (Neon) : copie la "Connection string" (pooled) depuis le dashboard Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
CLIENT_URL="http://localhost:5173"

# Compte admin créé par `npm run seed` (uniquement si aucun admin avec cet email n'existe déjà)
SEED_ADMIN_EMAIL="admin@section.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
